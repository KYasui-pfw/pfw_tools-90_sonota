# KRD MySQL → SQLite 同期処理
# 高頻度: 5分ごと、低頻度: 1時間ごと

# 環境変数の設定
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# 高頻度同期（5テーブル）- 5分ごとに実行
*/5 * * * * root cd /app && set -a && source .env && set +a && python3 /app/krd_sync_frequent.py >> /app/logs/cron_frequent.log 2>&1

# 低頻度同期（45テーブル）- 1時間ごとに実行
0 * * * * root cd /app && set -a && source .env && set +a && python3 /app/krd_sync_hourly.py >> /app/logs/cron_hourly.log 2>&1

# 空行が必要（cronの仕様）
