# .env.example
# 環境変数テンプレート
# このファイルをコピーして .env ファイルを作成し、実際の値を設定してください

# FastAPI接続設定
FASTAPI_BASE_URL=http://pfw-api
READ_API_KEY=your_read_api_key_here

# 監視設定
# DK020（受入）とDK040（棚出）を監視
# SYORIZUMIKBN: 1=未処理, 2=正常終了, 3=エラー
# 監視対象はコード内で固定（DK020, DK040）

# メール送信設定
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=rBOM System
MAIL_SUBJECT=【rBOM】実績登録エラー通知

# ログ設定
LOG_LEVEL=INFO
