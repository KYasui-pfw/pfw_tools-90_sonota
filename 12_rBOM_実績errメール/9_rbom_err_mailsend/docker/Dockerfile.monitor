# docker/Dockerfile.monitor
# エラー監視・メール送信プログラム用Dockerイメージ

FROM python:3.12-slim

# タイムゾーンを日本に設定
ENV TZ=Asia/Tokyo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# cronをインストール
RUN apt-get update && apt-get install -y cron && rm -rf /var/lib/apt/lists/*

# 作業ディレクトリを設定
WORKDIR /app

# 依存パッケージをインストール
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# アプリケーションコードをコピー
COPY app/ ./app/
COPY scripts/ ./scripts/
COPY .env ./

# cron設定ファイルをコピー
COPY docker/crontab /etc/cron.d/monitor-cron

# cron設定ファイルのパーミッションを設定
RUN chmod 0644 /etc/cron.d/monitor-cron

# cronジョブを登録
RUN crontab /etc/cron.d/monitor-cron

# ログディレクトリを作成
RUN mkdir -p /app/logs

# データベース初期化スクリプトを実行可能にする
RUN chmod +x /app/scripts/init_db.py

# 起動時にDB初期化してからcronを起動
CMD python /app/scripts/init_db.py && cron && tail -f /app/logs/monitor.log
