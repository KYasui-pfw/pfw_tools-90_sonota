# ====================================================
# 処理1: rBOM CSVファイルコピー・加工
# ====================================================

# rBOM CSVファイルパス（コンテナ内パス）
CSV1_PATH=/app/rBOM/rBOM_bat/PFW_OT/File/KAKOU_EXP/CAM/CAMKakouDenpyou.csv
CSV2_PATH=/app/rBOM/rBOM_bat/PFW_OT/File/KAKOU_EXP/CAM/CONV.csv
CSV3_PATH=/app/rBOM/rBOM_bat/PFW_OT/File/KAKOU_EXP/CAM/SEISANKI.csv
CSV4_PATH=/app/rBOM/rBOM_bat/PFW_OT/File/KAKOU_EXP/M_S/ASPKakouDenpyo.csv

# 加工対象ファイル名（項目削除・重複削除を行うファイル）
PROCESS_FILE1=CAMKakouDenpyou.csv
PROCESS_FILE2=ASPKakouDenpyo.csv

# 出力ファイル名（半角スペースを含む名前に対応）
OUTPUT_FILE1="4-01 CAMKakouDenpyo.csv"
OUTPUT_FILE2="4-03 ASPKakouDenpyo.csv"

# 削除対象カラム（カンマ区切り、空欄の場合は削除なし）
# 例: DELETE_COLUMNS_FILE1=カラム1,カラム2,カラム3
DELETE_COLUMNS_FILE1=
DELETE_COLUMNS_FILE2=

# 処理1の出力先
OUTPUT_DIR_DENPYO=/app/output/KakouDenpyo

# ====================================================
# 処理2: Access DB → CSV抽出
# ====================================================

# Access DBソースファイルパス（コンテナ内パス）
ACCDB_SOURCE1=/mnt/schejule/cylline/Cyl_pfw_table.accdb
ACCDB_SOURCE2=/mnt/schejule/camline/EJ/EJ_DETA_SERVER/EJデータマスター.accdb

# 抽出テーブル名
TABLE1_NAME=KaLstCyl_All
TABLE2_NAME=CAMFIN_LOG_ALL

# ジョブテーブル名（TABLE1とLEFT JOINするテーブル）
JOB_TABLE_NAME=ジョブ

# 出力ファイル名プレフィックス
OUTPUT_PREFIX1=Cyl_pfw_table
OUTPUT_PREFIX2=EJデータマスター

# 処理2の出力先
OUTPUT_DIR_JISSEKI=/app/output/KakouJisseki

# ====================================================
# 処理3・4: CSV → FastAPI completion エンドポイント送信
# ====================================================

# 処理3の入力CSVファイルパス（EJデータ）
PROCESS3_CSV_PATH=/app/output/KakouJisseki/EJデータマスター_CAMFIN_LOG_ALL.csv

# 処理4の入力CSVファイルパス（シリンダ・ダイアルデータ）
PROCESS4_CSV_PATH=/app/output/KakouJisseki/Cyl_pfw_table_KaLstCyl_All.csv

# FastAPI サーバーのベースURL（Dockerコンテナ名で指定）
FASTAPI_BASE_URL=http://fastapi-rbom-app:8000

# FastAPI READ用APIキー（状態チェック用）
READ_API_KEY=your_read_api_key_here

# FastAPI INSERT用APIキー（書き込み権限）
INSERT_API_KEY=your_insert_api_key_here

# ====================================================
# ログ設定
# ====================================================

# ログ出力先ディレクトリ
LOG_DIR=/app/logs

# ログ保持期間（日数）
LOG_RETENTION_DAYS=7
